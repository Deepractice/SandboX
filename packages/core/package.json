{
  "name": "@sandboxxjs/core",
  "version": "2.4.0",
  "description": "Core interfaces and runtime for sandboxxjs — unified sandbox lifecycle",
  "type": "module",
  "main": "dist/index.ts",
  "types": "dist/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "import": "./src/protocol.ts"
    },
    "./platform": {
      "types": "./src/platform.ts",
      "import": "./src/platform.ts"
    }
  },
  "dependencies": {
    "@deepracticex/rpc": "^1.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "import": "./dist/protocol.js"
      },
      "./platform": {
        "types": "./dist/platform.d.ts",
        "import": "./dist/platform.js"
      }
    }
  }
}
